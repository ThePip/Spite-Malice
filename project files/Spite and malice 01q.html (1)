<!-- floating run word — positioned dynamically over center deck area -->
<div id="runWord"></div>
<div id="dragGhost" class="card"></div>

<div id="winOverlay">
    <div class="win-box">
        <h2 id="winText">YOU WIN!</h2>
        <div class="win-score" id="winScore"></div>
        <p id="winSub">Congratulations!</p>
        <button onclick="startNewGame()">Play Again</button>
    </div>
</div>

<div id="settingsOverlay">
    <div class="settings-box">
        <h2>Settings</h2>
        <div class="settings-row">Sound <button class="toggle-btn on" id="soundToggle" onclick="toggleMute()">On</button></div>
        <div class="settings-row">Decks &amp; Goal <button class="toggle-btn" id="deckToggle" onclick="toggleTripleMode()">2 Decks</button></div>
        <div style="font-family:'Crimson Pro',serif;font-size:10px;color:rgba(255,255,255,0.3);text-align:right;margin:-10px 0 14px;">takes effect next game</div>
