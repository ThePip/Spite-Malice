// ============================================================
//  DRAG AND DROP
// ============================================================
function initDrag(card, source, clientX, clientY, originEl) {
    if (!playerTurn) return;
    dragCard = card; dragSource = source;
    dragGhostEl.style.width = "64px"; dragGhostEl.style.height = "92px";
    dragGhostEl.style.backgroundColor = "var(--card-white)";
    renderCardFace(dragGhostEl, card, null);
    dragGhostEl.style.transform = "rotate(4deg) scale(1.08)";
    dragGhostEl.style.boxShadow = "0 20px 40px rgba(0,0,0,0.6)";
    dragGhostEl.style.display = "block";
    dragOffsetX = 32; dragOffsetY = 46;
    moveDragGhost(clientX, clientY);
    if (originEl) originEl.classList.add("dragging");
    highlightDropZones(card);
    document.addEventListener("mousemove", onDragMove);
    document.addEventListener("mouseup", onDragEnd);
    document.addEventListener("touchmove", onDragTouchMove, { passive:false });
    document.addEventListener("touchend", onDragTouchEnd);
}

const moveDragGhost = (cx, cy) => { dragGhostEl.style.left = (cx - dragOffsetX) + "px"; dragGhostEl.style.top = (cy - dragOffsetY) + "px"; };
const onDragMove = e => { moveDragGhost(e.clientX, e.clientY); updateDropHover(e.clientX, e.clientY); };
const onDragTouchMove = e => { e.preventDefault(); const t = e.touches[0]; moveDragGhost(t.clientX, t.clientY); updateDropHover(t.clientX, t.clientY); };
const onDragEnd = e => finishDrag(e.clientX, e.clientY);
const onDragTouchEnd = e => { const t = e.changedTouches[0]; finishDrag(t.clientX, t.clientY); };

function updateDropHover(cx, cy) {
    if (currentDropTarget) { currentDropTarget.classList.remove("drop-zone-hover"); currentDropTarget = null; }
    dragGhostEl.style.display = "none";
    const el = document.elementFromPoint(cx, cy);
    dragGhostEl.style.display = "block";
    if (el) { const dz = el.closest("[data-dropzone]"); if (dz && dz.classList.contains("drop-zone-active")) { dz.classList.add("drop-zone-hover"); currentDropTarget = dz; } }
}

function finishDrag(cx, cy) {
    document.removeEventListener("mousemove", onDragMove); document.removeEventListener("mouseup", onDragEnd);
    document.removeEventListener("touchmove", onDragTouchMove); document.removeEventListener("touchend", onDragTouchEnd);
    dragGhostEl.style.display = "none"; dragGhostEl.style.transform = ""; dragGhostEl.style.boxShadow = ""; clearDropZones();
    if (!dragCard) return;
    const el = document.elementFromPoint(cx, cy);
    if (el) {
        const dz = el.closest("[data-dropzone]");
        if (dz) {
            const type = dz.getAttribute("data-dropzone"), idx = parseInt(dz.getAttribute("data-idx"));
            if (type === "center") tryPlayToCenter(idx);
            else if (type === "pdiscard") tryDiscardTo(idx);
        }
    }
    dragCard = null; dragSource = null;
    document.querySelectorAll(".dragging").forEach(e => e.classList.remove("dragging"));
    render();
}

const centerNeeded = i => center[i].length === 0 ? 1 : cardValue(center[i][center[i].length-1]) + 1;

function highlightDropZones(card) {
    const cv = cardValue(card);
    for (let i = 0; i < 5; i++) {
        if (cv === centerNeeded(i) || cv === 0) {
            const dz = document.querySelector(`[data-dropzone="center"][data-idx="${i}"]`);
            if (dz) dz.classList.add("drop-zone-active");
        }
    }
    if (dragSource && dragSource.type === "hand") document.querySelectorAll(`[data-dropzone="pdiscard"]`).forEach(dz => dz.classList.add("drop-zone-active"));
}

const clearDropZones = () => document.querySelectorAll(".drop-zone-active").forEach(el => el.classList.remove("drop-zone-active", "drop-zone-hover"));

// ============================================================
//  STACK BUILDERS
// ============================================================
const SLIVER_HEIGHTS = [1.8, 1.6, 1.3, 1.1, 0.9, 0.8, 0.7, 0.6, 0.5];

function buildSlivers(count) {
    if (count <= 0) return null;
    const wrap = document.createElement("div"); wrap.className = "stack-layers";
    let totalH = 0;
    for (let k = 0; k < count; k++) {
        const h = (SLIVER_HEIGHTS[k] !== undefined) ? SLIVER_HEIGHTS[k] : 0.5; totalH += h;
        const l = document.createElement("div"); l.className = "stack-layer"; l.style.height = h + "px";
        wrap.appendChild(l);
    }
    wrap.style.height = totalH + "px"; return wrap;
}

function setDropzone(el, type, idx) { el.setAttribute("data-dropzone", type); el.setAttribute("data-idx", idx); }
function makeEmpty(dt, di) { const e = document.createElement("div"); e.className = "stack-empty"; e.textContent = "Empty"; if (dt) setDropzone(e, dt, di); return e; }

function buildStackDiv(stack, onTopCardClick, showList, dropzoneType, dropzoneIdx) {
    if (stack.length === 0) return makeEmpty(dropzoneType, dropzoneIdx);
    const wrap = document.createElement("div"); wrap.className = "stack-wrap";
    if (dropzoneType) setDropzone(wrap, dropzoneType, dropzoneIdx);
    const top = document.createElement("div"); top.className = "top-card";
    if (onTopCardClick) top.onclick = e => { e.stopPropagation(); onTopCardClick(e); };
    const listHtml = (showList && stack.length > 1) ? stack.slice(0, -1).reverse().map(c => {
        const { val, suit } = parseCard(c);
        const isPurple = suit === "★", isRed = suitColor(suit) === "red";
        const col = isPurple ? "purple" : isRed ? "#c41e3a" : "#1a1a1a";
        const sh = (!isPurple && suit !== "♣") ? `<span class="suit-large" style="color:${col}">${suit}</span>` : `<span style="color:${col}">${suit}</span>`;
        return `<span style="color:${col}">${val}${sh}</span>`;
    }).join(" ") : null;
    renderCardFace(top, stack[stack.length-1], listHtml);
    if (dropzoneType === "pdiscard") {
        const card = stack[stack.length-1], src = { type:"discard", index:dropzoneIdx };
        top.addEventListener("mousedown", e => { if (playerTurn) initDrag(card, src, e.clientX, e.clientY, top); });
        top.addEventListener("touchstart", e => { if (playerTurn) { const t = e.touches[0]; initDrag(card, src, t.clientX, t.clientY, top); } }, { passive:true });
    }
    wrap.appendChild(top);
    const slivers = buildSlivers(stack.length - 1); if (slivers) wrap.appendChild(slivers);
    return wrap;
}

function buildGoalDiv(cardText, count, extraClass, onClick, isDraggable) {
    const wrap = document.createElement("div"); wrap.className = "goal-wrap";
    const card = document.createElement("div"); card.className = "goal-card" + (extraClass ? " " + extraClass : "");
    if (extraClass && extraClass.includes("draw-card")) {
        Object.assign(card.style, { display:"flex", flexDirection:"column", justifyContent:"center", alignItems:"center" });
        card.textContent = cardText;
    } else renderCardFace(card, cardText, null);
    if (onClick) card.onclick = onClick;
    if (isDraggable) {
        card.addEventListener("mousedown", e => { if (playerTurn) initDrag(cardText, { type:"goal" }, e.clientX, e.clientY, card); });
        card.addEventListener("touchstart", e => { if (playerTurn) { const t = e.touches[0]; initDrag(cardText, { type:"goal" }, t.clientX, t.clientY, card); } }, { passive:true });
    }
    wrap.appendChild(card);
    const slivers = buildSlivers(count); if (slivers) wrap.appendChild(slivers);
    return wrap;
}

// ============================================================
//  RENDER
// ============================================================
function render() {
    const $ = id => document.getElementById(id);

    // AI goal
    $("aiGoalArea").innerHTML = "";
    $("aiGoalArea").appendChild(aiGoal.length ? buildGoalDiv(aiGoal[aiGoal.length-1], Math.min(aiGoal.length-1, 9), "", null, false) : makeEmpty());

    // Draw deck
    $("drawDeckArea").innerHTML = "";
    $("drawDeckArea").appendChild(buildGoalDiv(deck.length ? "SPITE\n&\nMALICE" : "EMPTY", Math.min(Math.max(0, deck.length-1), 9), "draw-card", null, false));

    // Player goal
    $("playerGoalArea").innerHTML = "";
    if (playerGoal.length) {
        const card = playerGoal[playerGoal.length-1];
        $("playerGoalArea").appendChild(buildGoalDiv(card, Math.min(playerGoal.length-1, 9), "", playerTurn ? () => selectCard(card, "goal", playerGoal.length-1) : null, playerTurn));
    } else $("playerGoalArea").appendChild(makeEmpty());

    // Center stacks
    $("center").innerHTML = "";
    center.forEach((stack, i) => {
        const el = buildStackDiv(stack, null, false, "center", i);
        el.addEventListener("click", () => { if (selectedCard) playToCenter(i); });
        $("center").appendChild(el);
    });
    // Re-apply run glow after DOM rebuild
    if (currentRunStackIdx >= 0 && runMultiplier > 0) {
        updateRunStackGlow(currentRunStackIdx, true);
    }

    // Player discard
    $("playerDiscard").innerHTML = "";
    playerDiscard.forEach((stack, i) => {
        const fn = e => { if (e) e.stopPropagation(); if (stack.length) selectCard(stack[stack.length-1], "discard", i); togglePlayerDiscard(i); };
        $("playerDiscard").appendChild(buildStackDiv(stack, stack.length ? fn : null, expandedPlayerDiscards.has(i), "pdiscard", i));
    });

    // AI discard
    $("aiDiscard").innerHTML = "";
    aiDiscard.forEach((stack, i) => {
        const fn = stack.length ? e => { if (e) e.stopPropagation(); toggleAiDiscard(i); } : null;
        $("aiDiscard").appendChild(buildStackDiv(stack, fn, expandedAiDiscards.has(i)));
    });

    // Hand
    $("hand").innerHTML = "";
    const newCards = playerHand.filter(c => !prevHandSnapshot.includes(c));
    playerHand.forEach((card, i) => {
        const div = document.createElement("div");
        const isSel = selectedCard === card && selectedSource && selectedSource.type === "hand" && selectedSource.index === i;
        div.className = "card" + (isSel ? " selected" : "") + (newCards.includes(card) ? " card-deal" : "");
        if (newCards.includes(card)) div.style.animationDelay = (i * 0.04) + "s";
        renderCardFace(div, card, null);
        div.onclick = () => selectCard(card, "hand", i);
        div.addEventListener("mousedown", e => initDrag(card, { type:"hand", index:i }, e.clientX, e.clientY, div));
        div.addEventListener("touchstart", e => { const t = e.touches[0]; initDrag(card, { type:"hand", index:i }, t.clientX, t.clientY, div); }, { passive:true });
        $("hand").appendChild(div);
    });
    prevHandSnapshot = [...playerHand];

    showMoves(); checkWin();
    // Keep floating run word anchored above current run stack
    if (runMultiplier > 0) positionRunWord();
}

function selectCard(card, source, index) {
    if (!playerTurn) return;
    if (selectedCard === card && selectedSource && selectedSource.type === source && selectedSource.index === index) { selectedCard = null; selectedSource = null; }
    else { selectedCard = card; selectedSource = { type:source, index }; }
    playCardSlide(); render();
}

const togglePlayerDiscard = i => { if (expandedPlayerDiscards.has(i)) expandedPlayerDiscards.delete(i); else expandedPlayerDiscards.add(i); render(); };
const toggleAiDiscard = i => { if (expandedAiDiscards.has(i)) expandedAiDiscards.delete(i); else expandedAiDiscards.add(i); render(); };

function showMoves() {
    const container = document.getElementById("actionButtons"); container.innerHTML = "";
    if (!selectedCard) return;
    const cv = cardValue(selectedCard);
    for (let i = 0; i < 5; i++) {
        if (cv === centerNeeded(i) || cv === 0) {
            const btn = document.createElement("button"); btn.textContent = "▶"+(i+1); btn.onclick = () => playToCenter(i); container.appendChild(btn);
        }
    }
    if (selectedSource && selectedSource.type === "hand") {
        for (let i = 0; i < 5; i++) {
            const btn = document.createElement("button"); btn.textContent = "▽"+(i+1); btn.onclick = () => discardTo(i); container.appendChild(btn);
        }
    }
}

// ============================================================
//  PLAY LOGIC
// ============================================================
const resolveWild = (card, needed) => (card.startsWith(WILD) && !card.includes("(")) ? WILD+"("+values[needed-1]+")" : card;
const getCenterEl = i => document.querySelector(`[data-dropzone="center"][data-idx="${i}"] .top-card`) || document.querySelector(`[data-dropzone="center"][data-idx="${i}"]`);

function playCardToCenter(idx, card, source) {
    const needed = centerNeeded(idx), cv = cardValue(card);
    if (cv !== needed && cv !== 0) return false;

    const played = resolveWild(card, needed);
    center[idx].push(played);
    const stackEl = getCenterEl(idx);

    // Base +1 per center play
    addScore(1, stackEl);

    // Block AI bonus
    if (aiGoal.length) {
        const aiTopVal = cardValue(aiGoal[aiGoal.length-1]);
        if (aiTopVal > 0 && cardValue(played) === aiTopVal) {
            addScore(55, stackEl); playBlock(); showBlocked();
        }
    }

    // Track run
    recordCardPlayedToStack(idx);

    const isKing = cardValue(played) === 13;
    if (isKing) {
        addScore(SCORE.CENTER_CLEAR, stackEl);
        clearCenterStack(idx); playSuccess();
        if (source && source.type === "goal") { addScore(SCORE.GOAL_PLAY, stackEl); setTimeout(playGoalPlay, 520); }
        else if (source && source.type === "discard") setTimeout(playDiscardClear, 520);
    } else if (source && source.type === "goal") {
        addScore(SCORE.GOAL_PLAY, stackEl); playGoalPlay();
    } else {
        playCardPlace();
    }
    return true;
}

function tryPlayToCenter(idx) {
    if (!dragCard || !dragSource) return;
    if (!playCardToCenter(idx, dragCard, dragSource)) { playError(); return; }
    const didClear = center[idx].length === 0;
    removeFromSource(dragSource, didClear);
    if (playerHand.length === 0) refillHandToFive(playerHand);
    selectedCard = null; selectedSource = null;
    if (!checkWin()) render();
}

function tryDiscardTo(idx) {
    if (!dragCard || !dragSource || dragSource.type !== "hand") { playError(); return; }
    playerDiscard[idx].push(dragCard); playerHand.splice(dragSource.index, 1);
    maxDiscardDepth[idx] = Math.max(maxDiscardDepth[idx], playerDiscard[idx].length);
    playCardSlide(); selectedCard = null; selectedSource = null; endPlayerTurn();
}

function playToCenter(i) {
    if (!selectedCard || !playCardToCenter(i, selectedCard, selectedSource)) { playError(); return; }
    const didClear = center[i].length === 0;
    removeSelected(didClear);
    if (playerHand.length === 0) refillHandToFive(playerHand);
    if (!checkWin()) render();
}

function discardTo(i) {
    if (!selectedCard) return;
    playerDiscard[i].push(selectedCard);
    maxDiscardDepth[i] = Math.max(maxDiscardDepth[i], playerDiscard[i].length);
    removeSelected(); playCardSlide(); endPlayerTurn();
}

function endPlayerTurn() {
    settleRunBonus();       // award run bonus before switching
    playerTurn = false;
    document.getElementById("aiThinking").classList.add("show");
    setStatus("AI is thinking…"); render();
    setTimeout(aiTurn, 700);
}

function removeFromSource(source, centerCleared = false) {
    if (!source) return;
    if (source.type === "hand") {
        playerHand.splice(source.index, 1);
    } else if (source.type === "discard") {
        const peakDepth = maxDiscardDepth[source.index];
        playerDiscard[source.index].pop();
        if (playerDiscard[source.index].length === 0) {
            maxDiscardDepth[source.index] = 0;
            const pts = peakDepth >= 4 ? 25 : peakDepth === 3 ? 20 : peakDepth === 2 ? 10 : 0;
            if (pts > 0) {
                const discardEls = document.querySelectorAll("#playerDiscard .stack-wrap, #playerDiscard .stack-empty");
                addScore(pts, discardEls[source.index]);
            }
            if (centerCleared) setTimeout(playDiscardClear, 520);
            else playDiscardClear();
        }
    } else if (source.type === "goal") {
        playerGoal.pop();
    }
}

function removeSelected(centerCleared = false) {
    removeFromSource(selectedSource, centerCleared); selectedCard = null; selectedSource = null;
}

function checkWin() {
    if (playerGoal.length === 0) { showWin("YOU WIN!", "You cleared your goal pile. Glorious!"); return true; }
    if (aiGoal.length === 0) { showWin("AI WINS", "The machine was merciless this time."); return true; }
    return false;
}

function showWin(title, sub) {
    const won = title === "YOU WIN!";
    if (won) addScore(SCORE.WIN, document.getElementById("scoreDisplay"));
    playWin(); saveHighScore();
    document.getElementById("winText").textContent = title;
    document.getElementById("winScore").textContent = won ? "Score: " + score : "";
    const hs = getHighScores();
    document.getElementById("winSub").textContent = (won && hs[0] && hs[0].score === score) ? "🏆 New high score!" : sub;
    document.getElementById("winOverlay").classList.add("show");
}

function startNewGame() { document.getElementById("winOverlay").classList.remove("show"); deal(); }

// ============================================================
//  AI TURN
// ============================================================
function tryAiPlayCard(card, onSuccess) {
    for (let c = 0; c < 5; c++) {
        const needed = centerNeeded(c), cv = cardValue(card);
        const isWild = card.startsWith(WILD) && !card.includes("(");
        if (cv === needed || isWild) {
            center[c].push(isWild ? WILD+"("+values[needed-1]+")" : card);
            if (cardValue(center[c][center[c].length-1]) === 13) clearCenterStack(c);
            onSuccess(); playAiTurn(); return true;
        }
    }
    return false;
}

function aiTurn() {
    document.getElementById("aiThinking").classList.add("show");
    refillHandToFive(aiHand);
    let anyPlayed = true;
    while (anyPlayed) {
        anyPlayed = false;
        if (aiGoal.length && tryAiPlayCard(aiGoal[aiGoal.length-1], () => aiGoal.pop())) { anyPlayed = true; continue; }
        for (let d = 0; d < 5 && !anyPlayed; d++) {
            if (!aiDiscard[d].length) continue;
            if (tryAiPlayCard(aiDiscard[d][aiDiscard[d].length-1], () => aiDiscard[d].pop())) anyPlayed = true;
        }
        if (anyPlayed) continue;
        for (let i = 0; i < aiHand.length && !anyPlayed; i++) {
            if (tryAiPlayCard(aiHand[i], () => aiHand.splice(i, 1))) anyPlayed = true;
        }
    }
    if (aiHand.length > 0) {
        const cNeeds = center.map((_, i) => centerNeeded(i));
        const dScore = card => { const cv = cardValue(card); return Math.min(...cNeeds.map(n => Math.abs(cv - n))) * 2 + cv; };
        const sScore = (d, card) => { const st = aiDiscard[d], cv = cardValue(card); if (!st.length) return 10; const tv = cardValue(st[st.length-1]); if (tv - cv === 1) return 25; if (tv === cv) return 20; if (tv - cv === 2) return 12; if (cv > tv) return 3; return 1; };
        const bi = aiHand.reduce((b, c, i) => dScore(c) > dScore(aiHand[b]) ? i : b, 0);
        const bs = [0,1,2,3,4].reduce((b, d) => sScore(d, aiHand[bi]) > sScore(b, aiHand[bi]) ? d : b, 0);
        aiDiscard[bs].push(aiHand.splice(bi, 1)[0]);
    }
    document.getElementById("aiThinking").classList.remove("show");
    if (!checkWin()) startPlayerTurn();
}

// ============================================================
//  INIT
// ============================================================
loadBestScore();
runWordEl = document.getElementById("runWord");
deal();
</script>
