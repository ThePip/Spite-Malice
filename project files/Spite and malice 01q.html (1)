        <div class="scoring-note">Center play +1 &nbsp;·&nbsp; Block AI +55<br>Goal play +70 &nbsp;·&nbsp; Center clear +45 &nbsp;·&nbsp; Win +300<br>Discard clear: +10 (2) · +20 (3) · +25 (4+)<br>Run bonus: 5+ cards on one stack in one turn<br>Multiplier: 1→2→4→8→16→32→64→128×</div>
        <button onclick="clearHighScores()" style="width:100%;margin-bottom:10px;font-size:10px;padding:5px;opacity:0.7">Clear Scores</button>
        <button onclick="closeSettings()" style="width:100%">Close</button>
    </div>
</div>

<script>
// ============================================================
//  SOUND ENGINE
// ============================================================
let audioCtx = null, muted = false, tripleMode = false;
const getCtx = () => audioCtx || (audioCtx = new (window.AudioContext || window.webkitAudioContext)());

function playTone(freq, type, duration, vol = 0.3, delay = 0) {
    if (muted) return;
    try {
        const ctx = getCtx(), now = ctx.currentTime + delay;
        const osc = ctx.createOscillator(), gain = ctx.createGain();
        osc.connect(gain); gain.connect(ctx.destination);
        osc.type = type; osc.frequency.setValueAtTime(freq, now);
        gain.gain.setValueAtTime(vol, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
        osc.start(now); osc.stop(now + duration + 0.05);
    } catch(e) {}
}

function pageFlip(vol = 0.18) {
    if (muted) return;
    try {
        const ctx = getCtx(), now = ctx.currentTime, dur = 0.055;
        const buf = ctx.createBuffer(1, ctx.sampleRate * dur, ctx.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
        const src = ctx.createBufferSource(); src.buffer = buf;
        const hp = ctx.createBiquadFilter(); hp.type = 'highpass';
        hp.frequency.setValueAtTime(8000, now);
        hp.frequency.exponentialRampToValueAtTime(1200, now + dur);
        const gain = ctx.createGain();
        gain.gain.setValueAtTime(vol, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + dur);
        src.connect(hp); hp.connect(gain); gain.connect(ctx.destination);
        src.start(now); src.stop(now + dur + 0.01);
    } catch(e) {}
}

const playCardSlide  = () => pageFlip(0.18);
const playCardPlace  = () => pageFlip(0.22);
const playSuccess    = () => [523,659,784,1047].forEach((f,i) => playTone(f,'sine',0.18,0.25,i*0.08));
const playWin        = () => [523,659,784,1047,1319,1047,1319,2093].forEach((f,i) => playTone(f,'triangle',0.3,0.3,i*0.1));
const playAiTurn     = () => playTone(350,'sine',0.1,0.1);
const playError      = () => pageFlip(0.12);
const playDeal       = () => { for (let i=0;i<5;i++) setTimeout(()=>pageFlip(0.15),i*120); };
const playGoalPlay   = () => { playTone(440,'sine',0.18,0.22); playTone(659,'sine',0.22,0.18,0.1); };
const playDiscardClear = () => { pageFlip(0.25); playTone(880,'triangle',0.12,0.15,0.06); playTone(1109,'sine',0.18,0.12,0.14); };

function playBlock() {
    playTone(146.8, 'sawtooth', 0.5, 0.18);
    playTone(164.8, 'triangle', 0.45, 0.14, 0.03);
    playTone(220,   'triangle', 0.5, 0.16, 0.06);
    playTone(261.6, 'sawtooth', 0.4, 0.12, 0.09);
    playTone(293.6, 'sine',     0.35, 0.1, 0.25);
}

function toggleMute() {
    muted = !muted;
    document.getElementById("muteBtn").textContent = muted ? "🔇" : "🔊";
    const st = document.getElementById("soundToggle");
    st.textContent = muted ? "Off" : "On";
    st.classList.toggle("on", !muted);
}

function toggleTripleMode() {
    tripleMode = !tripleMode;
    const btn = document.getElementById("deckToggle");
    btn.textContent = tripleMode ? "3 Decks" : "2 Decks";
    btn.classList.toggle("on", tripleMode);
    loadBestScore();
}

// ============================================================
//  SCORING & HIGH SCORES
// ============================================================
const SCORE = { CENTER_CLEAR:45, DISCARD_CLEAR:25, GOAL_PLAY:70, WIN:300 };
let score = 0;
let flashQueue = [], flashTimer = null;

function addScore(pts, originEl, isRun = false) {
    score += pts;
    document.getElementById("scoreDisplay").textContent = score;
    if (originEl) {
        const r = originEl.getBoundingClientRect();
        flashQueue.push({ pts, x: r.left + r.width/2 - 20, y: r.top - 10, isRun });
        if (!flashTimer) drainFlashQueue();
    }
}

function drainFlashQueue() {
    if (!flashQueue.length) { flashTimer = null; return; }
    const { pts, x, y, isRun } = flashQueue.shift();
    const el = document.createElement("div");
    el.className = "score-flash" + (isRun ? " run-flash" : "");
    el.textContent = "+" + pts;
    el.style.left = x + "px";
    el.style.top  = y + "px";
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 1200);
    flashTimer = setTimeout(drainFlashQueue, 300);
}

const hsKey = () => tripleMode ? "smHighScores3" : "smHighScores2";
const getHighScores = () => { try { return JSON.parse(localStorage.getItem(hsKey())) || []; } catch(e) { return []; } };

function saveHighScore() {
    const hs = getHighScores();
    hs.push({ score, date: new Date().toLocaleDateString() });
    hs.sort((a,b) => b.score - a.score);
    hs.splice(10);
    localStorage.setItem(hsKey(), JSON.stringify(hs));
    document.getElementById("highScoreDisplay").textContent = (hs[0] && hs[0].score) ? hs[0].score : 0;
}

function loadBestScore() {
    const hs = getHighScores();
    document.getElementById("highScoreDisplay").textContent = (hs[0] && hs[0].score) ? hs[0].score : 0;
}

function clearHighScores() {
    if (!confirm("Clear all high scores?")) return;
    localStorage.removeItem(hsKey());
    document.getElementById("highScoreDisplay").textContent = 0;
    renderHsList();
}

function renderHsList() {
    const list = document.getElementById("hsList");
    const hs = getHighScores();
    document.getElementById("hsModeLabel").textContent = tripleMode ? "3-Deck Scores" : "2-Deck Scores";
    if (!hs.length) { list.innerHTML = `<p class='hs-empty'>No scores yet — win a game!</p>`; return; }
    list.innerHTML = hs.map((h,i) => `<li><span>#${i+1}&nbsp; ${h.date}</span><span>${h.score}</span></li>`).join("");
}

