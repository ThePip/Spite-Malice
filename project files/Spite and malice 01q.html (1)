    <span class="side-label">Center ▶</span>
    <div class="cards-row" id="center"></div>
</div>

<div class="divider"></div>

<div id="goalContainer">
    <div class="goal-col"><span class="goal-col-label">AI Goal</span><div id="aiGoalArea"></div></div>
    <div class="goal-col"><span class="goal-col-label">Deck</span><div id="drawDeckArea"></div></div>
    <div class="goal-col"><span class="goal-col-label bright">🤚 Goal</span><div id="playerGoalArea"></div></div>
</div>

